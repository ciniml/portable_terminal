# Copy to .env and fill in.  .env is gitignored - never commit real keys.
#
# Tailscale pre-auth key from:
#   https://login.tailscale.com/admin/settings/keys
#   Recommended: Reusable = ON, Pre-approved = ON (so no manual node approval).
#   The same reusable key can also be reused for the Tab5 firmware config.
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxx

# Demo SSH credentials (kept trivial on purpose - this is a throwaway target).
SSH_USER=demo
SSH_PASSWORD=demo
